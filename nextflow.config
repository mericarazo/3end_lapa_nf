manifest {
    name        = '3end_lapa_nf'
    author      = 'Maria Carazo'
    homePage    = 'https://github.com/mericarazo/3end_lapa_nf'
    description = '3-seq UMI -> LAPA -> differential polyA site usage (single pool)'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    // ---- entradas (obligatorias) ----
    reads        = null    // p. ej. '/ruta/fastqs/TDP43_KD_POOL_1_{1,2}.fq.gz'
    barcodes     = null    // FASTA de barcodes del pool (nombres tipo R1_NT, R2_TDP43 ...)
    star_index   = null
    genome_fasta = null
    genome_fai   = null    // por defecto <genome_fasta>.fai
    genome_sizes = null    // chrom.sizes
    lapa_gtf     = null    // GTF con three_prime_utr (gencode_utr_fix)
    gtf_names    = null    // GTF para nombres de gen (por defecto lapa_gtf)
    treatment    = null    // condicion de interes (p. ej. TDP43)
    control      = null    // condicion control (p. ej. NT)

    // ---- salida ----
    outdir       = 'results'
    pool_name    = 'pool1'
    publish_mode = 'copy'

    // ---- adaptadores / UMI ----
    adapter_r1   = 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA'
    adapter_r2   = 'AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT'
    umi_pattern  = 'NNNNN'

    // ---- internal priming ----
    ip_window    = 10      // nt
    ip_max_a     = 7       // se elimina si nº de A en la ventana > ip_max_a
    ip_max_run   = 6       // o si hay una racha de A consecutivas > ip_max_run

    // ---- LAPA ----
    lapa_min_replication_rate = 0.75
    lapa_cluster_window       = 100
    lapa_dataset              = 'condition'   // 'condition' (dataset = NT/TDP43) o 'single'
    // nombres de los ficheros que LAPA deja en lapa_out/ (comprobar con tu version)
    lapa_clusters_file = 'polyA_clusters.bed'
    lapa_counts_file   = 'lapa_counts.tsv'
    lapa_usage_file    = 'lapa_usage.tsv'

    // ---- filtros y estadistica ----
    min_mean     = 5        // media de counts en alguna condicion
    min_usage    = 0.0025   // usage medio en alguna condicion (fraccion; 0.0025 = 0.25 %)
    require_detected_all = false
    padj         = 0.05
    delta        = 0.05
    highlight    = 'STMN2'
    apa_analysis = false   // true: ejecuta APA_ANALYSIS (necesita treatment y control)
}

//process {
//    errorStrategy = { task.attempt <= 1 ? 'retry' : 'finish' }
//    maxRetries    = 1
// }

profiles {
    standard {
        includeConfig 'local.config'
    }

    conda {
        conda.enabled  = true
        conda.useMamba = false
    }

    // Cluster de Biogipuzkoa: SLURM + tus entornos conda ya creados
    biogi {
        process.executor      = 'slurm'
        //process.clusterOptions = '--partition=biogipuzkoa-exclusive --account=biogipuzkoa-exclusive'
        process.beforeScript  = 'module load Miniforge3'
        conda.enabled         = true
        process {
            withName: 'ADAPTER_TRIM|DEMULTIPLEX' { conda = '/scratch/mcarazo/envs/trimming/' }
            withName: 'UMI_EXTRACT|STAR_ALIGN|DEDUP' { conda = '/scratch/mcarazo/envs/STAR/' }
            withName: 'INTERNAL_PRIMING'          { conda = '/scratch/mcarazo/envs/biotools/' }
            withName: 'FASTQC|MULTIQC'            { conda = '/scratch/mcarazo/envs/QControl/' }
            withName: 'LAPA'                      { conda = '/scratch/mcarazo/envs/lapa/' }
        }
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }
