executor.name = 'local'

process {
    //errorStrategy = 'retry'
    //maxRetries    = 2

    // ----- limites de TU maquina: Nextflow recorta cualquier peticion que los supere -----
    // OJO: STAR con el genoma humano completo necesita ~30 GB de RAM; con menos no cargara el indice.
    resourceLimits = [ cpus: 8, memory: '32.GB', time: '24.h' ]

    // ----- imagenes PUBLICAS (ya existen; version fija, nunca :latest) -----
    withName: 'FASTQC' {
        container = 'staphb/fastqc:latest'
    }

    withName: 'MULTIQC' {
        container = 'ewels/multiqc:latest'
    }

    withName: 'ADAPTER_TRIM|DEMULTIPLEX' {
        container = 'mericarazo/trim:1.0'
    }

    withName: 'STAR_ALIGN' {
        container = 'ahr1/staraligner:2.7.10b'
    }
    
    // ----- imagenes PROPIAS (se construyen con containers/build.sh) -----
    withName: 'UMI_EXTRACT|DEDUP|INTERNAL_PRIMING' {
        container = 'mericarazo/biotools:1.0'
    }

    withName: 'LAPA' {
        container = 'mericarazo/lapa:1.0'
    }

    withName: 'APA_ANALYSIS' {
        container = 'mericarazo/analysis:1.0'
    }
}

docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'